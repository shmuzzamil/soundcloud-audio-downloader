# ==============================================================================
# [BrandName] - SoundCloud Link Helper & Permitted Audio Downloader Environment
# ==============================================================================

# Site Configuration
NEXT_PUBLIC_BRAND_NAME="SoundFetch"
NEXT_PUBLIC_SITE_URL="https://soundfetch.app"
NEXT_PUBLIC_SUPPORT_EMAIL="support@soundfetch.app"

# SoundCloud API Credentials (from https://developers.soundcloud.com/)
# Note: You can obtain Client ID and Client Secret by registering an App on SoundCloud
SOUNDCLOUD_CLIENT_ID=""
SOUNDCLOUD_CLIENT_SECRET=""

# Security & Cloudflare Turnstile CAPTCHA (Optional in local dev, recommended in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Rate Limiting Configuration (in requests per window)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Concurrency Queue Limit for Audio Streaming / ZIP Generation
MAX_CONCURRENT_DOWNLOADS=10

# Analytics & Verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Ad Network (Set to "true" to display compliant non-intrusive ad placeholders)
NEXT_PUBLIC_ENABLE_ADS="false"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

